{
  "name": "maseaaao-com",
  "private": true,
  "scripts": {
    "render:banners:youtube": "node scripts/render-scenes.mjs --scenes-dir dist/banners/youtube --output-dir dist/banners/rendered --width 2048 --height 1152 --format png",
    "render:banners:twitch": "node scripts/render-scenes.mjs --scenes-dir dist/banners/twitch --output-dir dist/banners/rendered --width 2224 --height 570 --format png",
    "render:logo": "node scripts/render-scenes.mjs --scenes-dir dist/logo --output-dir dist/logo/rendered --width 1920 --height 540 --format png --transparent",
    "render:scenes": "node scripts/render-scenes.mjs",
    "render:twitch-description": "node scripts/render-scenes.mjs --scenes-dir dist/twitch-description --output-dir dist/twitch-description/rendered --width 320 --height 64 --format png",
    "render:twitch-emotes": "node scripts/render-twitch-emotes.mjs",
    "render:twitch-points": "node scripts/render-twitch-points.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "full": "npm-run-all --parallel render:*",
    "postfull": "npm run optimize:images"
  },
  "dependencies": {
    "playwright-core": "^1.58.2"
  },
  "devDependencies": {
    "jpegtran-bin": "^7.0.0",
    "npm-run-all": "^4.1.5",
    "sharp": "^0.34.5"
  }
}
